# Pipedrive API Token
# Find your personal API token in Pipedrive: Settings > Personal preferences > API
PIPEDRIVE_API_TOKEN=your_pipedrive_api_token_here

# Shopify Dev Dashboard OAuth (Client Credentials)
SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here

# MongoDB Connection String (for saving quote submissions)
MONGODB_URI=your_mongodb_connection_string_here
